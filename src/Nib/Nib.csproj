<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nib</AssemblyName>
    <RootNamespace>Nib</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- One source of truth for the version flag, the release zip name and the
         VERSION.txt inside it. tools/release.ps1 overrides it on the publish
         command line, so the value here is only the dev-build default. -->
    <Version>0.6.0</Version>
    <Product>Nib</Product>
    <Company>Jeremy Champion</Company>
    <Description>A nano-style console text editor for Windows.</Description>

    <!-- TerminalWriter.Flush pins the frame buffer and hands a char* to WriteConsoleW. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Skips ICU load at startup. Safe because the editor compares strings ordinally. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- "Use LibraryImport instead of DllImport". Deliberate: the source generator
         does not handle the INPUT_RECORD[] marshalling any more clearly than
         DllImport does, and we are not targeting NativeAOT. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <!-- The renderer's diff (Screen) and the TerminalWriter test seam are exercised
       by Nib.Tests without a live console. Internal, not public: this is a test
       affordance, not part of any API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Nib.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Framework-dependent here on purpose: SelfContained=true would make every
         `dotnet build` copy the whole runtime into bin/, which wrecks the fast dev
         loop. Releases are self-contained — tools/release.ps1 sets it on the
         publish command line instead. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Required once TextMateSharp lands in phase 5: its Oniguruma wrapper is a
         native DLL, and single-file publish will not bundle native libraries
         without this. First launch extracts to %TEMP%\.net\nib\<hash>. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Engine only. We deliberately do NOT reference TextMateSharp.Grammars: it
       ships 40+ languages and 20 themes we would never open and is the single
       biggest contributor to binary size. See CLAUDE.md. -->
  <ItemGroup>
    <PackageReference Include="TextMateSharp" Version="1.0.66" />
  </ItemGroup>

  <!-- Vendored by tools/fetch-grammars.ps1 and committed; not built from source.
       The manifest rides along as a resource so language detection reads the same
       extension/filename/shebang table the vendoring script does. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Grammars\*.json.gz" />
    <EmbeddedResource Include="Resources\Themes\*.json.gz" />
    <EmbeddedResource Include="..\..\grammars\manifest.json" LogicalName="Nib.Resources.manifest.json" />
  </ItemGroup>

</Project>
