{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "hedgerow",
  "version": "2.4.1-beta.3",
  "private": true,
  "description": "Static site pipeline for the field notes archive.",
  "license": "MIT",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "node bin/build.mjs --minify",
    "dev": "node bin/build.mjs --watch --port 4173",
    "test": "node --test test/",
    "lint": "eslint . --max-warnings 0"
  },
  "build": {
    "outDir": "dist",
    "clean": true,
    "sourcemap": false,
    "targets": ["es2022", "chrome120", "firefox121"],
    "assets": {
      "images": { "formats": ["avif", "webp"], "widths": [480, 960, 1920] },
      "fonts": { "preload": true, "subset": "latin" }
    },
    "retries": 2,
    "timeoutMs": 30000
  },
  "deploy": {
    "provider": "s3",
    "bucket": "field-notes-static",
    "region": "eu-west-2",
    "invalidate": ["/index.html", "/feed.xml"],
    "headers": [
      { "match": "*.html", "cacheControl": "public, max-age=300" },
      { "match": "assets/*", "cacheControl": "public, max-age=31536000, immutable" }
    ]
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "eslint": "^9.6.0"
  }
}
